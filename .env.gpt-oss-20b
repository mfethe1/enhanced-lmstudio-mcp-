# OpenAI GPT-OSS-20B Optimized Configuration
# This configuration optimizes the MCP server for the openai/gpt-oss-20b reasoning model

# === PRIMARY MODEL CONFIGURATION ===
MODEL_NAME=openai/gpt-oss-20b
LMSTUDIO_MODEL=openai/gpt-oss-20b

# === REASONING MODEL OPTIMIZATIONS ===
# Extended timeouts for reasoning models (they need more time to think)
HTTP_CONNECT_TIMEOUT=15
HTTP_READ_TIMEOUT_SIMPLE=120
HTTP_READ_TIMEOUT_COMPLEX=300

# LM Studio specific settings
LMSTUDIO_MAX_RETRIES=3
LMSTUDIO_RETRY_BACKOFF=2.0

# === CIRCUIT BREAKER SETTINGS ===
# More tolerant settings for reasoning models
CIRCUIT_LMSTUDIO_THRESHOLD=10
CIRCUIT_LMSTUDIO_RECOVERY=180

# === TOOL TIMEOUTS ===
# Extended timeouts for complex operations
CREW_TOOL_TIMEOUT=420
SMART_PLAN_IMMEDIATE_TIMEOUT_SEC=360
ROUTER_BG_TIMEOUT_SEC=500

# === FALLBACK CONFIGURATION ===
# Allow fallbacks when LM Studio fails (recommended for production)
NO_FALLBACK_PROVIDERS=0

# === ROUTER SETTINGS ===
# Enable router wrapping for better model selection
ROUTER_WRAP_MLR=1
ROUTER_MAX_TOKENS=4000

# === PERFORMANCE SETTINGS ===
# Optimized for reasoning models
TOOLCALL_DEFAULT_TEMPERATURE=0.1
PERFORMANCE_THRESHOLD=0.3

# === LOGGING ===
LOG_LEVEL=INFO

# === REASONING MODEL FEATURES ===
# These are automatically detected but can be overridden
# REASONING_MODEL_ENABLED=1
# REASONING_FALLBACK_TO_COMPLETIONS=1
# REASONING_EXTRACT_FROM_REASONING_FIELD=1
